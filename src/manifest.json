{
    "manifest_version": 2,
    "name": "MyEyes!",
    "version": "0.1.1",
    "author": "Carlos Cabrera",
    "description": "__MSG_extension_description__",
    "default_locale": "en",
    "browser_action": {
        "default_title": "MyEyes!",
        "default_icon": {
            "38": "icons/me_active_38.png",
            "19": "icons/me_active_19.png"
        },
        "default_popup": "ui/popup/index.html"
    },
    "icons": {
        "16": "icons/me_16.png",
        "48": "icons/me_48.png",
        "128": "icons/me_128.png"
    },
    "background": {
        "persistent": true,
        "page": "background/index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "inject/fallback.js",
                "inject/index.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true
        }
    ],
    "permissions": [
        "alarms",
        "fontSettings",
        "storage",
        "tabs",
        "<all_urls>"
    ],
    "optional_permissions": [
        "contextMenus"
    ],
    "commands": {
        "addSite": {
            "suggested_key": {
                "default": "Alt+Shift+A"
            },
            "description": "__MSG_toggle_current_site__"
        },
        "cycleSiteTheme": {
            "suggested_key": {
                "default": "Alt+Shift+T"
            },
            "description": "__MSG_cycle_site_theme__"
        },
        "enhanceSite": {
            "suggested_key": {
                "default": "Alt+Shift+E"
            },
            "description": "__MSG_enhance_site__"
        },
        "toggle": {
            "description": "__MSG_toggle_extension__"
        },
        "cycleDefaultTheme": {
            "description": "__MSG_cycle_default_theme__"
        },
        "switchEngine": {
            "description": "__MSG_theme_generation_mode__"
        }
    }
}
